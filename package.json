{
  "name": "icares-dashboard",
  "productName": "Icares Dashboard",
  "version": "0.3.0",
  "private": true,
  "description": "Intern dashboard van Icares: wachtwoordkluis en scripts",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx tools/seed.ts",
    "e2e": "electron-vite build && node tests/e2e.mjs",
    "dist": "electron-vite build && electron-builder --win portable nsis"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "imapflow": "^2.12.2",
    "jsqr": "^1.4.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0"
  },
  "author": "Icares B.V.",
  "build": {
    "appId": "nl.icares.dashboard",
    "productName": "Icares Dashboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/briefpapier.png",
        "to": "briefpapier.png"
      },
      {
        "from": "resources/bundled",
        "to": "bundled"
      },
      {
        "from": "build/python",
        "to": "python"
      },
      {
        "from": "resources/administratie",
        "to": "administratie"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "IcaresDashboard-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "IcaresDashboard-${version}-draagbaar.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "IcaresDashboard-${version}-installatie.exe",
      "shortcutName": "Icares Dashboard"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
